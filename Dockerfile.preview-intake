FROM node:22-alpine
WORKDIR /app
RUN mkdir /data && chown node:node /data
COPY scripts/preview-intake.mjs ./preview-intake.mjs
ENV NODE_ENV=production PREVIEW_INTAKE_PATH=/data/submissions.jsonl
USER node
EXPOSE 4100
HEALTHCHECK --interval=20s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:4100/health || exit 1
CMD ["node", "preview-intake.mjs"]
