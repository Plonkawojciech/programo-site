# Template for local env vars. Copy to .env.local and fill in real values —
# .env* is gitignored (except this file), so nothing here is a live secret.
#
# This list covers what CLAUDE.md documents as required for `npm run dev` to
# fully work (lead pipeline) plus the search-engine verification vars added
# for SEO structured data. It is NOT an exhaustive audit of every
# process.env.* read in the codebase — CRM auth, GA4 Measurement Protocol and
# Upstash Redis vars live in src/lib/analytics/**, tracking.ts and the CRM
# routes, which are out of scope here (see progress.md for who owns that).

# Lead pipeline — /api/contact (Resend transactional email)
RESEND_API_KEY=
EMAIL_TO=biuro@programo.pl

# Lead pipeline — Telegram notification on new lead
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PageSpeed Insights API (used by the /stack or performance tooling)
PAGESPEED_API_KEY=

# Calendly/booking link surfaced in contact CTAs
NEXT_PUBLIC_BOOKINGS_URL=

# Google Search Console site-ownership verification (HTML tag method).
# Search Console > Settings > Ownership verification > HTML tag > copy just
# the `content` value (not the whole <meta> tag). Renders nothing if unset.
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools site-ownership verification (meta tag method).
# Bing Webmaster Tools > Settings > site verification > "Option 2: Meta tag"
# > copy just the `content` value. Renders nothing if unset.
NEXT_PUBLIC_BING_VERIFICATION=
