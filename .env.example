# Template for local env vars. Copy to .env.local and fill in real values —
# .env* is gitignored (except this file), so nothing here is a live secret.
#
# This list covers what CLAUDE.md documents as required for `npm run dev` to
# fully work (lead pipeline) plus the search-engine verification vars added
# for SEO structured data. It is NOT an exhaustive audit of every
# process.env.* read in the codebase — CRM auth, GA4 Measurement Protocol and
# Upstash Redis vars live in src/lib/analytics/**, tracking.ts and the CRM
# routes, which are out of scope here (see progress.md for who owns that).

# Lead pipeline — /api/contact, e-mail notification via Microsoft 365 (Graph).
# NOT a third-party e-mail provider: Programo already pays for M365, so the
# notification is sent as an existing mailbox at no extra cost and with no extra
# processor in the privacy policy. Resend was removed 2026-08-04 and is not
# coming back. Setup steps: see the header of src/lib/mail/graph.ts.
# All five must be set or the channel stays off (Telegram still works).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Mailbox the notification is sent AS (must exist in the tenant).
LEAD_MAIL_FROM=biuro@programo.pl
# Where it lands. Defaults to LEAD_MAIL_FROM when empty.
LEAD_MAIL_TO=biuro@programo.pl

# Lead pipeline — Telegram notification on new lead
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PageSpeed Insights API (used by the /stack or performance tooling)
PAGESPEED_API_KEY=

# Calendly/booking link surfaced in contact CTAs
NEXT_PUBLIC_BOOKINGS_URL=

# Google Search Console site-ownership verification (HTML tag method).
# Search Console > Settings > Ownership verification > HTML tag > copy just
# the `content` value (not the whole <meta> tag). Renders nothing if unset.
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools site-ownership verification (meta tag method).
# Bing Webmaster Tools > Settings > site verification > "Option 2: Meta tag"
# > copy just the `content` value. Renders nothing if unset.
NEXT_PUBLIC_BING_VERIFICATION=

# --- Meta (Facebook/Instagram) ---------------------------------------------
# Dataset ID = the number formerly called Pixel ID (Events Manager -> Datasets).
# Public by design: it ships in the page.
NEXT_PUBLIC_META_DATASET_ID=
# Conversions API token: Events Manager -> Settings -> Conversions API ->
# Generate access token. SERVER ONLY - never prefix with NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=
# Dev/staging only: makes events appear in Events Manager -> Test Events.
# Meta requires it ABSENT on production payloads.
META_TEST_EVENT_CODE=

# --- GA4 Measurement Protocol (server-side conversions) --------------------
# GA4 -> Admin -> Data Streams -> Measurement Protocol API secrets. SERVER ONLY.
GA4_API_SECRET=
GA4_MEASUREMENT_ID=G-KT2R144BYG

# --- First-party event store (Upstash Redis / Vercel KV) -------------------
# Either pair works; production currently uses the KV_* naming.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- IndexNow ---------------------------------------------------------------
# Optional. Defaults to the key file already present in public/<key>.txt.
INDEXNOW_KEY=
