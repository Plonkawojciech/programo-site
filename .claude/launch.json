{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "programo-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "programo-site-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "--port",
        "3200"
      ],
      "port": 3200
    }
  ]
}